{
  "name": "mirocraft-web",
  "version": "1.0.0",
  "description": "Mirocraft web panel",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/keep-dist.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:themes": "node src/themes/contrast.test.mjs",
    "test:colors": "node scripts/check-color-literals.mjs",
    "test": "npm run typecheck && npm run test:themes && npm run test:colors",
    "docs": "node scripts/docs-site.mjs ../site"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "10.4.20",
    "marked": "^15.0.6",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "vite": "^8.2.1"
  },
  "private": true,
  "type": "module"
}
