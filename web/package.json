{
  "name": "mirocraft-web",
  "version": "1.0.0",
  "description": "Mirocraft web panel",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:themes": "node src/themes/contrast.test.mjs",
    "test:colors": "node scripts/check-color-literals.mjs",
    "test": "npm run typecheck && npm run test:themes && npm run test:colors"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "playwright": "1.49.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "vite": "5.4.11"
  },
  "private": true,
  "type": "module"
}
